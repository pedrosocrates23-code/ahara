---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import CTAButton from '@/components/CTAButton.astro';
import CTANikoBanner from '@/components/CTANikoBanner.astro';
import { site } from '@/data/site';
import { faqPageNode, articleSemanticLinks, normalizeIntent, siloOf, isPillar, siloItemListNode } from '@/lib/schema';

export async function getStaticPaths() {
  // Publicação programada: a página só é gerada quando pub_date <= agora (no build).
  const posts = await getCollection('blog', ({ data }) => !data.draft && (process.env.AHARA_PUBLISH_ALL === '1' || data.pub_date.getTime() <= Date.now()));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const url = `${site.url}/blog/${post.id}/`;
const waPost = site.whatsapp.link(`Olá, vim do artigo "${post.data.h1}" e gostaria de saber mais`);

// Desambiguação semântica: cada intenção (atacado/revenda/revender) tem sua própria
// entidade `about`. Resolve canibalização — os spokes deixam de declarar todos a
// mesma entidade (Organization) e passam a apontar para a intenção + o Produto.
const rawTopic = post.id.match(/(atacado|revenda|revender|para-revenda)/)?.[1] ?? null;
const links = articleSemanticLinks(normalizeIntent(rawTopic));

// Arquitetura de silo: pillar (hub) ↔ spokes — fluxo de autoridade vertical.
const silo = siloOf(post.id);
const amIPillar = isPillar(post.id);
const pillarUrl = silo.pillarSlug ? `${site.url}/blog/${silo.pillarSlug}/` : null;

// Pillar lista seus spokes (gera os links internos hub → spoke).
const siloSpokes = amIPillar
  ? allPosts
      .filter((p) => siloOf(p.id).key === silo.key && p.id !== post.id)
      .sort((a, b) => b.data.pub_date.getTime() - a.data.pub_date.getTime())
  : [];
const siloItemList =
  amIPillar && siloSpokes.length > 0
    ? siloItemListNode(
        url,
        siloSpokes.map((p) => ({ url: `${site.url}/blog/${p.id}/`, name: p.data.h1 })),
      )
    : null;

// Spoke aponta isPartOf ao Blog + ao pillar do silo (envia autoridade ao hub).
const isPartOfRefs =
  !amIPillar && pillarUrl
    ? [{ '@id': `${site.url}/blog/#blog` }, { '@id': `${pillarUrl}#webpage` }]
    : { '@id': `${site.url}/blog/#blog` };

// Breadcrumb: Início › {Silo (→ pillar)} › Post. O pillar usa Blog como nível.
const crumbs = amIPillar
  ? [
      { name: 'Início', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: post.data.h1, url: `/blog/${post.id}/` },
    ]
  : [
      { name: 'Início', url: '/' },
      { name: silo.name, url: pillarUrl ? `/blog/${silo.pillarSlug}/` : '/blog/' },
      { name: post.data.h1, url: `/blog/${post.id}/` },
    ];

// ──────────────────────────────────────────────────────────────────────────────
// DESAMBIGUAÇÃO GEOGRÁFICA — nó de lugar por UF
//
// O cluster programático por estado (batata-chips-atacado-{uf}, -revenda-{uf},
// -revender-{uf}) saía com `about` byte a byte idêntico em todos os posts: a UF
// existia só no slug e servia apenas para pontuar relacionados — nunca chegava ao
// JSON-LD. Aqui ela vira um nó de lugar com @id estável por estado, emitido
// INLINE no @graph da própria página (nunca como referência pendurada), e o
// BlogPosting o declara em duas propriedades verificadas em schema.org:
//   contentLocation  — domain CreativeWork, range Place ("the location depicted
//                      or described in the content")
//   spatialCoverage  — subpropriedade de contentLocation, para "the place(s)
//                      which are the focus of the content"
//
// O nó carrega só nome, sigla e o país que o contém. Nada de população, área,
// coordenada ou qualquer atributo do estado — esses dados não estão no
// repositório e não seriam verificáveis.
// ──────────────────────────────────────────────────────────────────────────────
const UF_NAMES: Record<string, string> = {
  ac: 'Acre',
  al: 'Alagoas',
  am: 'Amazonas',
  ap: 'Amapá',
  ba: 'Bahia',
  ce: 'Ceará',
  df: 'Distrito Federal',
  es: 'Espírito Santo',
  go: 'Goiás',
  ma: 'Maranhão',
  mg: 'Minas Gerais',
  ms: 'Mato Grosso do Sul',
  mt: 'Mato Grosso',
  pa: 'Pará',
  pb: 'Paraíba',
  pe: 'Pernambuco',
  pi: 'Piauí',
  pr: 'Paraná',
  rj: 'Rio de Janeiro',
  rn: 'Rio Grande do Norte',
  ro: 'Rondônia',
  rr: 'Roraima',
  rs: 'Rio Grande do Sul',
  sc: 'Santa Catarina',
  se: 'Sergipe',
  sp: 'São Paulo',
  to: 'Tocantins',
};

const ufRe = /-(ac|al|am|ap|ba|ce|df|es|go|ma|mg|ms|mt|pa|pb|pe|pi|pr|rj|rn|ro|rr|rs|sc|se|sp|to)$/;
const postUf = post.id.match(ufRe)?.[1] ?? null;

// Nem todo post geográfico traz a sigla no fim do slug: o cluster de food service
// da expansão (Goiânia, São Paulo) e os posts de fábrica nomeiam a praça por
// extenso. Sem esta tabela, justamente as páginas do ângulo de expansão saíam sem
// nenhuma declaração de lugar. A chave é o trecho procurado no slug; `uf` amarra a
// cidade ao estado que a contém, para o grafo não ter dois lugares soltos.
const CIDADES: Record<string, { nome: string; uf: string; tipo: 'City' | 'AdministrativeArea' }> = {
  goiania: { nome: 'Goiânia', uf: 'go', tipo: 'City' },
  'sao-paulo': { nome: 'São Paulo', uf: 'sp', tipo: 'City' },
  brasilia: { nome: 'Brasília', uf: 'df', tipo: 'City' },
  // Taguatinga é Região Administrativa do DF, não município: o supertipo direto
  // é o tipo honesto aqui, pelo mesmo motivo aplicado às RAs em src/lib/schema.ts.
  taguatinga: { nome: 'Taguatinga', uf: 'df', tipo: 'AdministrativeArea' },
};

const cidadeKey = Object.keys(CIDADES).find((c) => post.id.includes(c)) ?? null;
const cidade = cidadeKey ? CIDADES[cidadeKey] : null;

// A UF vem da sigla no fim do slug ou, quando o slug nomeia a cidade, do estado dela.
const uf = postUf ?? cidade?.uf ?? null;

// schema.org/State é "A state or province of a country" — vale para as 26 unidades
// que são estados. O Distrito Federal não é estado nem província, então fica no
// supertipo direto, AdministrativeArea ("a geographical region, typically under the
// jurisdiction of a particular government"), que é exato para ele e é o mesmo
// supertipo já usado em src/lib/schema.ts para as Regiões Administrativas do DF.
const ufPlace = uf
  ? {
      '@type': uf === 'df' ? 'AdministrativeArea' : 'State',
      '@id': `${site.url}/#place-${uf}`,
      name: UF_NAMES[uf],
      alternateName: uf.toUpperCase(),
      containedInPlace: { '@type': 'Country', name: 'Brasil' },
    }
  : null;

// Quando o post é sobre uma praça específica, o lugar do conteúdo é a cidade, e o
// estado entra como o lugar que a contém — não como um segundo foco concorrente.
const cidadePlace =
  cidade && ufPlace
    ? {
        '@type': cidade.tipo,
        '@id': `${site.url}/#place-${cidadeKey}`,
        name: cidade.nome,
        containedInPlace: { '@id': ufPlace['@id'] },
      }
    : null;

// O foco declarado: a cidade quando existe, senão o estado.
const focoPlace = cidadePlace ?? ufPlace;

// Formata a data em português para exibição. Intl com timeZone UTC evita que a
// data publicada como meia-noite ISO apareça um dia antes no fuso de Brasília.
const dataPorExtenso = (d: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(d);

const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.data.h1,
  description: post.data.meta_description,
  url,
  inLanguage: 'pt-BR',
  datePublished: post.data.pub_date.toISOString(),
  dateModified: (post.data.updated_date ?? post.data.pub_date).toISOString(),
  wordCount: post.data.palavras_totais,
  keywords: post.data.keyword,
  // articleSection recebe o nome do silo, e não uma constante: com o mesmo valor nos
  // 89 posts a propriedade não informava nada e ainda contradizia o BreadcrumbList da
  // própria página, que já declara o silo.
  articleSection: silo.name,
  author: { '@id': `${site.url}/autor/joao-amaro/#person` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: { '@id': `${url}#webpage` },
  isPartOf: isPartOfRefs,
  about: links.about,
  mentions: links.mentions,
  ...(focoPlace
    ? {
        contentLocation: { '@id': focoPlace['@id'] },
        spatialCoverage: { '@id': focoPlace['@id'] },
      }
    : {}),
  image: {
    '@type': 'ImageObject',
    url: `${site.url}/images/hero-chips.webp`,
    width: 1200,
    height: 630,
  },
};

const faqSchema =
  post.data.faq && post.data.faq.length > 0
    ? faqPageNode(url, post.data.faq)
    : null;

// ──────────────────────────────────────────────────────────────────────────────
// STUBS QUE FECHAM AS REFERÊNCIAS @id DESTA PÁGINA
//
// O isPartOf do BlogPosting cita dois @id que só eram DEFINIDOS em outras
// páginas: o Blog (definido em /blog/) e a WebPage do pillar do silo (definida
// na própria página do pillar). Vistas daqui, as duas eram referência pendurada
// — exatamente o defeito que buildGraph() já resolve para o Produto e a Marca.
// Aqui aplicamos a mesma regra: nó MÍNIMO, só identidade, com os mesmos valores
// da definição canônica, sem reescrever nem contradizer nada.
// ──────────────────────────────────────────────────────────────────────────────
const blogNode = {
  '@type': 'Blog',
  '@id': `${site.url}/blog/#blog`,
  url: `${site.url}/blog/`,
  name: 'Blog Ahara',
  inLanguage: 'pt-BR',
  publisher: { '@id': `${site.url}/#organization` },
};

// Só para spoke: na página do pillar a WebPage canônica já é emitida pelo Layout
// com este mesmo @id, e um stub aqui a duplicaria.
const pillarPost =
  !amIPillar && silo.pillarSlug ? allPosts.find((p) => p.id === silo.pillarSlug) : undefined;
const pillarStub =
  pillarUrl && pillarPost
    ? {
        // Mesmo @type e mesmo name que o Layout gera na página do pillar
        // (pageType CollectionPage; name = fullTitle = "<seo_title|h1> | Ahara").
        '@type': 'CollectionPage',
        '@id': `${pillarUrl}#webpage`,
        url: pillarUrl,
        name: `${pillarPost.data.seo_title || pillarPost.data.h1} | ${site.name}`,
      }
    : null;

const extraSchemas = [
  articleSchema,
  ...(ufPlace ? [ufPlace] : []),
  ...(cidadePlace ? [cidadePlace] : []),
  blogNode,
  ...(pillarStub ? [pillarStub] : []),
  ...(links.extraNode ? [links.extraNode] : []),
  ...(siloItemList ? [siloItemList] : []),
  ...(faqSchema ? [faqSchema] : []),
];

// ──────────────────────────────────────────────────────────────────────────────
// LEIA TAMBÉM — afinidade por silo/intenção + distribuição determinística
//
// O algoritmo anterior pontuava por UF e por um regex de tópico curto
// (atacado|revenda|revender|para-revenda|caseira|10kg|copa) e desempatava por
// pub_date DESC. Medido sobre os 89 slugs reais: em 45 posts NENHUM candidato
// pontuava, então os 3 "relacionados" viravam simplesmente os 3 posts mais
// recentes do site. Distribuição resultante: 46 posts sem nenhum link recebido e
// os três mais novos recebendo 47, 46 e 44.
//
// Duas mudanças resolvem isso:
//
//  1. A afinidade passa a vir do SILO — a mesma taxonomia que já governa o
//     breadcrumb e o isPartOf desta página — e da intenção normalizada, com a UF
//     como refinamento. Como todo post pertence a algum silo, nenhum candidato
//     fica sem sinal.
//
//  2. O desempate deixa de ser a data e passa a ser o número de links JÁ
//     atribuídos ao candidato nesta mesma passagem: dentro de uma faixa de
//     afinidade, vence quem recebeu menos. É isso que espalha o link equity em
//     vez de concentrá-lo nos posts mais novos.
//
// O grafo inteiro é reconstruído em toda página a partir de `allPosts`, sempre
// na mesma ordem alfabética de slug e sem Date.now(), sem índice de página e sem
// aleatoriedade — logo o resultado é idêntico entre builds e idêntico em
// qualquer página que o monte. Medido depois da mudança: 0 posts sem link, mínimo
// 2, mediana 3, máximo 4 (1,33x a mediana) e 100% dos links dentro do silo.
// ──────────────────────────────────────────────────────────────────────────────
const RELATED_COUNT = 3;
const intentRe = /(atacado|para-revenda|revenda|revender)/;

interface PostFacets {
  id: string;
  silo: string;
  intent: string | null;
  uf: string | null;
}

const facetsOf = (id: string): PostFacets => ({
  id,
  silo: siloOf(id).key,
  intent: normalizeIntent(id.match(intentRe)?.[1] ?? null),
  uf: id.match(ufRe)?.[1] ?? null,
});

/**
 * Afinidade em faixas largas e propositalmente grosseiras: o objetivo é separar
 * "mesmo tópico" de "outro tópico", não produzir um ranking fino. Faixas largas
 * deixam empates suficientes para o balanceador de carga abaixo distribuir.
 *
 * O pillar do silo NÃO recebe bônus aqui: ele já recebe um link de cada spoke
 * pelo breadcrumb e pelo isPartOf. Um bônus extra, medido, levava o pillar de
 * atacado-revenda a 15 links recebidos contra mediana 3 — recriando em menor
 * escala a concentração que esta função existe para eliminar.
 */
function affinity(a: PostFacets, b: PostFacets): number {
  let score = 0;
  if (a.silo === b.silo) score += 100;               // mesmo cluster temático
  if (a.intent && a.intent === b.intent) score += 40; // mesma intenção comercial
  if (a.uf && a.uf === b.uf) score += 25;             // mesmo estado
  return score;
}

const allFacets = allPosts
  .map((p) => facetsOf(p.id))
  .sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));

const inboundLinks = new Map<string, number>(allFacets.map((f) => [f.id, 0]));
const relatedByPost = new Map<string, string[]>();

for (const current of allFacets) {
  const picks = allFacets
    .filter((candidate) => candidate.id !== current.id)
    .map((candidate) => ({ id: candidate.id, score: affinity(current, candidate) }))
    .sort(
      (x, y) =>
        y.score - x.score ||
        (inboundLinks.get(x.id) ?? 0) - (inboundLinks.get(y.id) ?? 0) ||
        (x.id < y.id ? -1 : x.id > y.id ? 1 : 0),
    )
    .slice(0, RELATED_COUNT);

  for (const pick of picks) inboundLinks.set(pick.id, (inboundLinks.get(pick.id) ?? 0) + 1);
  relatedByPost.set(
    current.id,
    picks.map((pick) => pick.id),
  );
}

const postsById = new Map(allPosts.map((p) => [p.id, p]));
const related = (relatedByPost.get(post.id) ?? [])
  .map((id) => postsById.get(id))
  .filter((p): p is (typeof allPosts)[number] => p !== undefined);

// Posts locais (DF/Brasília/Taguatinga) ativam seção de mapa no template
const localPattern = /brasília|brasilia|\bdf\b|taguatinga|distrito federal/i;
const isLocalPost =
  localPattern.test(post.data.h1) ||
  localPattern.test(post.data.keyword) ||
  localPattern.test(post.data.meta_description) ||
  localPattern.test(post.id);
---

<Layout
  title={post.data.seo_title || post.data.h1}
  description={post.data.meta_description}
  ogImage="/images/hero-chips.webp"
  pageType={amIPillar ? 'CollectionPage' : 'WebPage'}
  breadcrumbs={crumbs}
  extraSchemas={extraSchemas}
>

  <!-- ━━ HERO ━━ -->
  <section class="bg-brand-orange border-b-[3px] border-black py-16 md:py-20 overflow-hidden relative">
    <div class="absolute -right-10 top-0 w-72 h-72 bg-brand-yellow/20 blob-organic pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-4">
      {/*
        O breadcrumb visível percorre o mesmo array `crumbs` que alimenta o
        BreadcrumbList do JSON-LD. Antes eram dois níveis fixos (Início / Blog)
        contra três declarados na marcação: o silo era afirmado ao buscador e nunca
        mostrado ao leitor. O último nível é o próprio post, então vai sem link.
      */}
      <nav class="mb-6 text-sm text-white/90" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="mx-2">/</span>}
            {i === crumbs.length - 1 ? (
              <span aria-current="page" class="text-white/70">{c.name}</span>
            ) : (
              <a href={c.url} class="hover:underline">{c.name}</a>
            )}
          </>
        ))}
      </nav>
      <span class="inline-block bg-brand-yellow border-2 border-black px-3 py-1 text-xs font-impact shadow-brutal mb-4 rounded-full">
        BLOG AHARA
      </span>
      <h1 class="font-display font-bold text-3xl md:text-5xl text-white leading-tight mb-4">
        {post.data.h1}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-white/90">
        <a
          href="/autor/joao-amaro/"
          class="inline-flex items-center gap-2 hover:text-brand-yellow transition-colors"
        >
          <span class="w-7 h-7 rounded-full bg-brand-yellow border-2 border-black flex items-center justify-center font-display font-bold text-black text-xs flex-shrink-0">J</span>
          <span class="font-medium">João Amaro</span>
        </a>
        <span class="text-white/40">·</span>
        {/*
          Data visível na página, e não só no JSON-LD. O Google orienta que a data
          marcada apareça para o leitor, e num conteúdo B2B que publica tabela de
          preço a data é o que diz se o número ainda vale. Quando o artigo foi
          revisado depois de publicado, as duas datas aparecem: a de publicação
          situa o texto no tempo e a de atualização diz que ele foi conferido.
        */}
        <time datetime={post.data.pub_date.toISOString()}>
          {dataPorExtenso(post.data.pub_date)}
        </time>
        {post.data.updated_date && (
          <>
            <span class="text-white/40">·</span>
            <span class="text-white/80">
              atualizado em{' '}
              <time datetime={post.data.updated_date.toISOString()}>
                {dataPorExtenso(post.data.updated_date)}
              </time>
            </span>
          </>
        )}
        <span class="text-white/40">·</span>
        <span>Leitura de ~{Math.ceil(post.data.palavras_totais / 220)} min</span>
      </div>
    </div>
  </section>

  <!-- ━━ SUMÁRIO ━━ -->
  {post.data.sumario_html && (
    <section class="bg-linen py-8 md:py-10 border-b-[3px] border-black">
      <div class="max-w-3xl mx-auto px-4">
        <div class="card-brutal bg-brand-yellow p-6 md:p-8">
          <div class="text-xs font-impact mb-2 tracking-wider">TL;DR</div>
          <div class="font-body text-base md:text-lg leading-relaxed prose-content" set:html={post.data.sumario_html}></div>
        </div>
      </div>
    </section>
  )}

  <!-- ━━ CONTEÚDO ━━ -->
  <article class="bg-linen py-12 md:py-16 border-b-[3px] border-black">
    <div class="max-w-3xl mx-auto px-4">
      <div id="prose-body" class="prose-content font-body text-black leading-relaxed">
        <div id="niko-cta" style="display:none"><CTANikoBanner /></div>
        <Content />
      </div>
    </div>
  </article>

  <script>
    const banner = document.getElementById('niko-cta');
    const prose  = document.getElementById('prose-body');
    const firstH2 = prose?.querySelector('h2');
    if (banner && firstH2) {
      banner.style.display = '';
      firstH2.parentNode.insertBefore(banner, firstH2);
    }
  </script>

  <!-- ━━ MAPA LOCAL + NIKO CTA ━━ -->
  {isLocalPost && (
    <section class="bg-brand-yellow border-b-[3px] border-black py-12 md:py-16">
      <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-8 items-center">

        <!-- Mapa -->
        <div>
          <h2 class="font-display font-bold text-2xl md:text-3xl text-black mb-2">
            Fábrica aqui no DF
          </h2>
          <p class="font-body text-sm text-black/70 mb-4">{site.address.full}</p>
          <div class="overflow-hidden rounded-2xl border-[3px] border-black shadow-brutal">
            <iframe
              title="Localização Ahara – ADE Águas Claras, Brasília/DF"
              src={`https://maps.google.com/maps?q=${site.address.mapsQuery}&output=embed&hl=pt-BR`}
              width="100%"
              height="240"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <!-- Niko CTA -->
        <div class="card-brutal bg-white p-6 md:p-8 flex flex-col gap-4">
          <span class="inline-block bg-brand-red border-2 border-black px-3 py-1 text-xs font-impact shadow-brutal rounded-full text-white w-fit">
            PRODUTO NIKO
          </span>
          <h3 class="font-display font-bold text-2xl md:text-3xl leading-tight">
            Niko Batata Chips:<br/>
            <span class="text-brand-purple">o simples bem feito.</span>
          </h3>
          <p class="font-body text-sm text-black/70 leading-relaxed">
            Produzido por Ahara em Brasília/DF. Batata frita tipo chips sabor tradicional
            (sal), em embalagens de 50g, 150g e 500g. Pedido mínimo 5kg com desconto
            progressivo de até 12%.
          </p>
          <div class="flex flex-wrap gap-3">
            <CTAButton href="/produtos/" label="Ver Niko Chips" variant="purple" icon="arrow" />
            <CTAButton href={waPost} label="Pedir agora" variant="green" icon="whatsapp" external={true} />
          </div>
        </div>

      </div>
    </section>
  )}

  <!-- ━━ PILLAR: PÁGINAS DESTE TÓPICO (hub → spokes) ━━ -->
  {amIPillar && siloSpokes.length > 0 && (
    <section class="bg-brand-green border-b-[3px] border-black py-12 md:py-16">
      <div class="max-w-5xl mx-auto px-4">
        <span class="inline-block bg-brand-yellow border-2 border-black px-3 py-1 text-xs font-impact shadow-brutal mb-4 rounded-full">
          {silo.name.toUpperCase()}
        </span>
        <h2 class="font-display font-bold text-2xl md:text-3xl text-white mb-6">
          Todas as páginas deste tópico ({siloSpokes.length})
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {siloSpokes.map((p) => (
            <a href={`/blog/${p.id}/`} class="card-brutal bg-white p-5 flex flex-col gap-2 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-brutal-lg transition-all">
              <h3 class="font-display font-bold text-base leading-tight">{p.data.h1}</h3>
              <span class="text-xs font-body text-brand-purple font-bold mt-auto">Ver página →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ━━ CTA FINAL ━━ -->
  <section class="bg-brand-purple border-b-[3px] border-black py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 flex flex-col md:flex-row items-start md:items-center gap-6 justify-between">
      <div>
        <h2 class="font-display font-bold text-2xl md:text-3xl text-white mb-2">Pronto para começar?</h2>
        <p class="font-body text-white/95">Pedido mínimo 5kg · desconto progressivo até 12% · entrega no DF.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <CTAButton href={waPost} label="WhatsApp" variant="green" icon="whatsapp" external={true} />
        <CTAButton href="/contato/" label="Contato" variant="yellow" />
      </div>
    </div>
  </section>

  <!-- ━━ LEIA TAMBÉM ━━ -->
  <section class="bg-linen py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-black mb-6">Leia também</h2>
      <div class="grid md:grid-cols-3 gap-5">
        {related.map((p) => (
          <a href={`/blog/${p.id}/`} class="card-brutal bg-white p-5 flex flex-col gap-3 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-brutal-lg transition-all">
            <span class="inline-block bg-brand-yellow border-2 border-black px-2 py-0.5 text-xs font-impact w-fit rounded-full">ARTIGO</span>
            <h3 class="font-display font-bold text-lg leading-tight">{p.data.h1}</h3>
            <p class="font-body text-sm text-black/70 leading-snug line-clamp-3">{p.data.meta_description}</p>
            <span class="text-xs font-body text-brand-purple font-bold mt-auto">Ler artigo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

