---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import WaTracking from '@/components/WaTracking.astro';
import { site } from '@/data/site';
import {
  buildGraph,
  webPageNode,
  breadcrumbNode,
  autoBreadcrumbs,
  type BreadcrumbItem,
} from '@/lib/schema';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  preloadImage?: string;
  /**
   * Tipo de WebPage para esta rota. Default: 'WebPage'.
   * Use 'AboutPage' em /sobre/, 'ContactPage' em /contato/, 'CollectionPage' em listagens.
   */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ItemPage';
  /**
   * Breadcrumbs custom para a página. Se omitido, é auto-gerado a partir do pathname.
   * Passe array vazio [] para suprimir o BreadcrumbList nesta página.
   */
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Nodes extras de @graph (Service, Product, BlogPosting, FAQPage, HowTo, etc.).
   * Cada node DEVE ter @id próprio e fazer referência a Organization/WebSite via @id.
   */
  extraSchemas?: Record<string, unknown>[];
}

const {
  title,
  description = 'Distribuidora B2B de batatas chips artesanais produzidas localmente em Brasília/DF. Atendemos revendedores, comércios, eventos e food service.',
  ogImage = '/images/hero-chips.webp',
  preloadImage,
  pageType = 'WebPage',
  breadcrumbs,
  extraSchemas = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} | Ahara`;
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';

// Breadcrumbs: home não tem; caso contrário usa o passado ou auto-gera
const crumbs: BreadcrumbItem[] = isHome
  ? []
  : breadcrumbs ?? autoBreadcrumbs(pathname, title);

// WebPage para esta rota
const pageNode = webPageNode({
  pathname,
  title: fullTitle,
  description,
  type: pageType,
  image: ogImage,
  breadcrumbs: crumbs,
});

// Nodes da rota: WebPage + (BreadcrumbList se houver) + extras passados pela página
const routeNodes: Record<string, unknown>[] = [pageNode];
if (crumbs.length > 0) routeNodes.push(breadcrumbNode(pathname, crumbs));
routeNodes.push(...extraSchemas);

// @graph unificado — Organization + Logo + WebSite + nodes da rota
const graph = buildGraph(routeNodes);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="color-scheme" content="light" />
    <style>:root,html{color-scheme:only light}</style>
    <meta name="theme-color" content="#6654ca" />
    <meta name="author" content={site.legalName} />
    <meta name="geo.region" content="BR-DF" />
    <meta name="geo.placename" content="Brasília" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={`${site.name} - ${title}`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.legalName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Schema.org JSON-LD — @graph unificado (Jarno van Driel pattern) -->
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Preconnect + Preload de recursos críticos -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- Google Fonts (substitutos até as fontes oficiais chegarem) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&family=Dancing+Script:wght@700&family=Anton&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&family=Dancing+Script:wght@700&family=Anton&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wvl9rw93w5");
    </script>

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P7MVJ8Q12H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P7MVJ8Q12H');
    </script>
  </head>
  <body>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <WaTracking />
  </body>
</html>
